<script>
  (function(){
    var radios = document.querySelectorAll('#zipdownload-clear-form input[name="mode"]');
    var dtBeforeSingle = document.getElementById('before-datetime');
    var dtAfter = document.getElementById('after-datetime');
    var dtBeforeRange = document.getElementById('before-datetime-range');
    function toggle(){
      var isBefore = document.querySelector('#zipdownload-clear-form input[name="mode"][value="before"]').checked;
      var isRange = document.querySelector('#zipdownload-clear-form input[name="mode"][value="range"]').checked;
      dtBeforeSingle.disabled = !(isBefore);
      dtAfter.disabled = !(isRange);
      dtBeforeRange.disabled = !(isRange);
    }
    radios.forEach(function(r){ r.addEventListener('change', toggle); });
    toggle();
  })();
  function initAjaxPager() {
    var container = document.getElementById('zipdownload-logs');
    if (!container) {
      return;
    }

    var busy = false;
    var loadPartial = function(url, fullUrl) {
      if (!url || busy) {
        return;
      }
      busy = true;
      fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'same-origin'
      })
        .then(function(resp) {
          if (!resp.ok) {
            throw new Error('Failed to load logs');
          }
          return resp.text();
        })
        .then(function(html) {
          container.innerHTML = html;
          if (fullUrl) {
            window.history.replaceState({}, '', fullUrl);
          }
        })
        .catch(function() {
          if (fullUrl) {
            window.location.href = fullUrl;
          }
        })
        .finally(function() {
          busy = false;
        });
    };

    container.addEventListener('click', function(e) {
      var link = e.target.closest('a.js-zipd-page');
      if (!link || link.classList.contains('disabled') || link.getAttribute('aria-disabled') === 'true') {
        return;
      }
      var ajaxUrl = link.getAttribute('data-ajax-url');
      var fullUrl = link.getAttribute('href');
      if (!ajaxUrl) {
        return;
      }
      e.preventDefault();
      loadPartial(ajaxUrl, fullUrl);
    });

    container.addEventListener('change', function(e) {
      var select = e.target.closest('select.js-zipd-per-page');
      if (!select) {
        return;
      }
      var option = select.options[select.selectedIndex];
      var ajaxUrl = option ? option.getAttribute('data-url') : '';
      var fullUrl = option ? option.getAttribute('data-full-url') : '';
      if (!ajaxUrl) {
        return;
      }
      loadPartial(ajaxUrl, fullUrl);
    });

    container.addEventListener('submit', function(e) {
      var form = e.target.closest('form.js-zipd-jump-form');
      if (!form) {
        return;
      }
      e.preventDefault();

      var formData = new FormData(form);
      var params = new URLSearchParams(formData);
      var fullUrl = form.action + '?' + params.toString();
      params.set('ajax', '1');
      var ajaxUrl = form.action + '?' + params.toString();
      loadPartial(ajaxUrl, fullUrl);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAjaxPager);
  }
  else {
    initAjaxPager();
  }
</script>

