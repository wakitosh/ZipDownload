$tz = (string) ($this->setting('time_zone', 'UTC')); // System timezone
$fmt = function ($ts) use ($tz) {
  $ts = (int) $ts;
  if ($ts <= 0) return '-';
  try {
    $dt = new \DateTime('@' . $ts); // UTC base
    $dt->setTimezone(new \DateTimeZone($tz));
    return $dt->format('Y-m-d H:i:s');
  } catch (\Throwable $e) {
    return date('Y-m-d H:i:s', $ts);
  }
};
